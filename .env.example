# OpenAI-compatible chat completions endpoint. Keep real secrets in .env only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Replicate text-to-video. Choose a model and configure its input fields for that model.
# Never commit real tokens.
VIDEO_API_BASE_URL=https://api.replicate.com/v1
VIDEO_API_TOKEN=
VIDEO_MODEL=
VIDEO_TIMEOUT_SECONDS=60
VIDEO_PROMPT_FIELD=prompt
VIDEO_ASPECT_RATIO_FIELD=aspect_ratio
VIDEO_DURATION_FIELD=duration
